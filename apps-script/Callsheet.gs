function enqueue_(ss,o){var q=ss.getSheetByName(CFG.QUEUE_SHEET);if(!q){q=ss.insertSheet(CFG.QUEUE_SHEET);q.appendRow(['Created','Status','JSON']);q.hideSheet();}q.appendRow([new Date(),'PENDING',JSON.stringify(o)]);}function ensureQueueTrigger_(){if(!ScriptApp.getProjectTriggers().some(function(t){return t.getHandlerFunction()==='processCallsheetQueue';}))ScriptApp.newTrigger('processCallsheetQueue').timeBased().everyMinutes(1).create();}
function processCallsheetQueue(){var ss=SpreadsheetApp.openById(CFG.SPREADSHEET_ID),q=ss.getSheetByName(CFG.QUEUE_SHEET);if(!q||q.getLastRow()<2)return;var rows=q.getRange(2,1,q.getLastRow()-1,3).getValues();for(var i=0;i<rows.length;i++){if(rows[i][1]!=='PENDING')continue;var r=i+2;try{q.getRange(r,2).setValue('PROCESSING');var job=JSON.parse(rows[i][2]),url=createCallsheetPdf_(job);writePdfLink_(ss,job,url);q.getRange(r,2).setValue('DONE');}catch(e){q.getRange(r,2).setValue('ERROR: '+String(e.message||e));}break;}}
function createCallsheetPdf_(job){job.storePhotoData=[];(job.storePhotoUrls||[]).forEach(function(urls){var data={};Object.keys(urls||{}).forEach(function(k){var m=String(urls[k]).match(/[-\w]{25,}/);if(m){var b=DriveApp.getFileById(m[0]).getBlob();data[k]='data:'+b.getContentType()+';base64,'+Utilities.base64Encode(b.getBytes());}});job.storePhotoData.push(data);});var t=HtmlService.createTemplateFromFile('CallsheetPDF');t.job=job;t.approver=approver_(job.area);var evaluated=t.evaluate().getContent(),blob=Utilities.newBlob(evaluated,'text/html','Daily Callsheet.html').getAs(MimeType.PDF).setName('Daily Callsheet_'+safe_(job.payload.header.jobOrder)+'.pdf');return DriveApp.getFolderById(job.folderId).createFile(blob).getUrl();}
