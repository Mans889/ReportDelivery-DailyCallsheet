const CFG=Object.freeze({SPREADSHEET_ID:'1le65u_d176ywE6eUUMaOU8ffTNEgnQNKzWFS66Ia080',MASTER_DATA_SHEET:'MASTER-DATA',MASTER_STORE_SHEET:'MASTER-TOKO 5.2',TEMPLATE_AREA_SHEET:'DPC Jakarta Timur (Halim)',ROOT_FOLDER_ID:'1BPo-iJcOyauvIXe2LTHWtUwqcMzFEcDc',MASTER_DATA_HEADER_ROW:17,MASTER_DATA_START_ROW:18,HEADER_ROW:1,STORE_START_ROW:13,QUEUE_SHEET:'_CALLSHEET_QUEUE',TZ:'Asia/Jakarta'});
const AREAS=['DPC JAKARTA TIMUR (HALIM)','ADW JAKARTA UTARA (SUNTER)','ADW BOGOR','ADW TANGERANG','ADW RANGKAS','ADW SERANG','DPC TANGERANG A (CIKUPA)','DPC BOGOR (DRAMAGA)'];
const ROUTES=['DPC Jakarta Timur (Halim)','ADW Jakarta Utara (Sunter)','DC Cikarang','ADW Bogor','ADW Tangerang (Cikokol)','ADW Serang','ADW Jakarta Timur A','DPC Bogor (Ciampea)','ADW Jakarta Pusat (Kemayoran)','ADW Jakarta Selatan (Ps Minggu)','DPC Pondok Pinang','ADW Bekasi','ADW Karawang','ADW Jakarta Barat (Kebon Jeruk)','DPC Jakarta Utara (Semper)'];
const OUTPUT_HEADERS=['Week','Ritase','Date','No. Job Order','Area','Crew ID','Nama Driver','Nama Helper','Nomor Polisi','Tipe Unit','Vendor','Jam Masuk','Jam Pulang','ID Toko','Nama Toko','Biaya TKBM','Biaya Parkir Liar','Biaya Giro','Biaya Keamanan','Biaya Tol','Biaya Lain-lain','Status Mutasi','Dari','Tujuan','Foto Kwitansi TKBM','Foto Struk Parkir Liar','Foto Kwitansi Giro','Kwitansi Biaya Keamanan','Foto Struk Tol','Foto Biaya Lain-lain','Callsheet PDF'];
function getBootstrapData(){const ss=SpreadsheetApp.openById(CFG.SPREADSHEET_ID),md=ss.getSheetByName(CFG.MASTER_DATA_SHEET);if(!md)throw new Error('Sheet MASTER-DATA tidak ditemukan.');const lastCol=md.getLastColumn(),headers=md.getRange(CFG.MASTER_DATA_HEADER_ROW,1,1,lastCol).getDisplayValues()[0],hm=headerMap_(headers),ix={area:findHeader_(hm,['area']),crew:findHeader_(hm,['crew id']),driver:findHeader_(hm,['nama driver']),helper:findHeader_(hm,['nama helper']),rider:findHeader_(hm,['rider id']),plate:findHeader_(hm,['nomor polisi','nopol']),unit:findHeader_(hm,['tipe unit']),vendor:findHeader_(hm,['vendor'])};validateMasterDataHeaders_(ix);const count=Math.max(0,md.getLastRow()-CFG.MASTER_DATA_START_ROW+1),rows=count?md.getRange(CFG.MASTER_DATA_START_ROW,1,count,lastCol).getDisplayValues():[],schedule=[8,9,10,11,12,13,14],crews=rows.filter(r=>r[ix.crew]||r[ix.driver]).map(r=>({area:r[ix.area]||'',crewId:r[ix.crew]||'',driver:r[ix.driver]||'',helper:ix.helper>=0?r[ix.helper]||'':'',riderId:ix.rider>=0?r[ix.rider]||'':'',plate:normalizePlate_(r[ix.plate]||''),unit:r[ix.unit]||'',vendor:r[ix.vendor]||'',schedule:schedule.map(i=>r[i]||'')}));const st=ss.getSheetByName(CFG.MASTER_STORE_SHEET);if(!st)throw new Error('Sheet MASTER-TOKO 5.2 tidak ditemukan.');const sc=Math.max(0,st.getLastRow()-CFG.STORE_START_ROW+1),stores=sc?st.getRange(CFG.STORE_START_ROW,2,sc,3).getDisplayValues().filter(r=>r[0]&&r[1]).map(r=>({area:String(r[0]).trim(),id:String(r[1]).trim(),name:String(r[2]).trim()})):[];return{ok:true,areas:AREAS,routes:ROUTES,crews,stores};}
function validateMasterDataHeaders_(x){const m=[];[['area','Area'],['crew','Crew ID'],['driver','Nama Driver'],['plate','Nomor Polisi'],['unit','Tipe Unit'],['vendor','Vendor']].forEach(a=>{if(x[a[0]]<0)m.push(a[1]);});if(m.length)throw new Error('Header MASTER-DATA baris 17 tidak ditemukan: '+m.join(', '));}
function submitData(p){validate_(p);const lock=LockService.getScriptLock();lock.waitLock(30000);try{const ss=SpreadsheetApp.openById(CFG.SPREADSHEET_ID),area=canonicalArea_(p.header.area),sheet=ensureAreaSheet_(ss,area),week='Week '+Utilities.formatDate(new Date(p.header.date+'T00:00:00'),CFG.TZ,'w'),folders=buildFolders_(area,week,p.header.date,p.header.vendor,p.header.driver),urls={};Object.keys(p.photos||{}).forEach(k=>{if(p.photos[k])urls[k]=saveDataUrl_(folders[k]||folders.root,p.photos[k],k);});const start=Math.max(2,sheet.getLastRow()+1),hm=headerMap_(sheet.getRange(CFG.HEADER_ROW,1,1,sheet.getLastColumn()).getDisplayValues()[0]),rows=p.stores.map(s=>{const rec=recordFor_(p,s,week,urls),row=new Array(sheet.getLastColumn()).fill('');OUTPUT_HEADERS.forEach(n=>{const c=hm[normalize_(n)];if(c!==undefined)row[c]=rec[n]!==undefined?rec[n]:'';});return row;});sheet.getRange(start,1,rows.length,rows[0].length).setValues(rows).setHorizontalAlignment('center').setVerticalAlignment('middle').setBorder(true,true,true,true,true,true,'#9ca3af',SpreadsheetApp.BorderStyle.DASHED);sheet.setHiddenGridlines(true);applyLinks_(sheet,start,rows.length,hm,urls);const jobId=Utilities.getUuid();enqueue_(ss,{jobId,area,rowStart:start,count:rows.length,payload:p,photoUrls:urls,folderId:folders.pdf.getId()});ensureQueueTrigger_();return{ok:true,jobId,message:'Data tersimpan. PDF diproses di latar belakang.'};}finally{lock.releaseLock();}}
function validate_(p){if(!p||!p.header)throw new Error('Payload tidak valid.');['date','jobOrder','area','crewId','driver','plate','timeIn','timeOut'].forEach(k=>{if(!String(p.header[k]||'').trim())throw new Error('Field wajib belum lengkap: '+k);});if(!/^JO-\d+$/.test(p.header.jobOrder))throw new Error('No. Job Order harus JO- diikuti angka.');if(!Array.isArray(p.stores)||!p.stores.length)throw new Error('Minimal satu toko.');if(!getBootstrapData().crews.some(x=>normalizePlate_(x.plate)===normalizePlate_(p.header.plate)))throw new Error('Data Tidak Ada, Mohon Periksa Kembali!');const req={tkbm:'Foto Kwitansi TKBM',parking:'Foto Parkir Liar',giro:'Foto Giro',security:'Foto Keamanan',toll:'Foto Tol',other:'Foto Lain-lain'};Object.keys(req).forEach(k=>{if(p.stores.some(s=>Number((s.costs||{})[k]||0)>0)&&!(p.photos||{})[k])throw new Error(req[k]+' wajib.');});}
function recordFor_(p,s,w,u){const h=p.header,c=s.costs||{},m=p.mutation||{};return{'Week':w,'Ritase':s.ritase||1,'Date':new Date(h.date+'T00:00:00'),'No. Job Order':h.jobOrder,'Area':canonicalArea_(h.area),'Crew ID':h.crewId,'Nama Driver':h.driver,'Nama Helper':proper_(h.helper),'Nomor Polisi':normalizePlate_(h.plate),'Tipe Unit':h.unit,'Vendor':h.vendor,'Jam Masuk':h.timeIn,'Jam Pulang':h.timeOut,'ID Toko':s.id,'Nama Toko':s.name,'Biaya TKBM':+c.tkbm||0,'Biaya Parkir Liar':+c.parking||0,'Biaya Giro':+c.giro||0,'Biaya Keamanan':+c.security||0,'Biaya Tol':+c.toll||0,'Biaya Lain-lain':+c.other||0,'Status Mutasi':m.enabled?'Ya':'No','Dari':m.from||'','Tujuan':(m.destinations||[]).join(' | '),'Foto Kwitansi TKBM':u.tkbm||'','Foto Struk Parkir Liar':u.parking||'','Foto Kwitansi Giro':u.giro||'','Kwitansi Biaya Keamanan':u.security||'','Foto Struk Tol':u.toll||'','Foto Biaya Lain-lain':u.other||'','Callsheet PDF':''};}
function ensureAreaSheet_(ss,n){let s=ss.getSheetByName(n);if(s)return s;const t=ss.getSheetByName(CFG.TEMPLATE_AREA_SHEET);if(!t)throw new Error('Sheet template tidak ditemukan.');s=t.copyTo(ss).setName(n);if(s.getLastRow()>1)s.getRange(2,1,s.getMaxRows()-1,s.getMaxColumns()).clearContent();s.setHiddenGridlines(true);return s;}
function buildFolders_(a,w,d,v,r){let f=DriveApp.getFolderById(CFG.ROOT_FOLDER_ID);[a,w,d,safe_(v),safe_(r)].forEach(n=>f=getOrCreate_(f,n));return{root:f,tkbm:getOrCreate_(f,'Kwitansi TKBM'),parking:getOrCreate_(f,'Kwitansi Parkir Liar'),giro:getOrCreate_(f,'Kwitansi Giro'),security:getOrCreate_(f,'Kwitansi Biaya Keamanan'),toll:getOrCreate_(f,'Struk Tol'),other:getOrCreate_(f,'Biaya Lain-lain'),pdf:getOrCreate_(f,'Callsheet PDF')};}
function getOrCreate_(p,n){const i=p.getFoldersByName(n);return i.hasNext()?i.next():p.createFolder(n);}function saveDataUrl_(f,d,l){const m=String(d).match(/^data:(image\/[\w.+-]+);base64,(.+)$/);if(!m)throw new Error('Format foto tidak valid.');return f.createFile(Utilities.newBlob(Utilities.base64Decode(m[2]),m[1],safe_(l)+'_'+Date.now()+'.jpg')).getUrl();}
function applyLinks_(s,r,n,h,u){const p={'Foto Kwitansi TKBM':'tkbm','Foto Struk Parkir Liar':'parking','Foto Kwitansi Giro':'giro','Kwitansi Biaya Keamanan':'security','Foto Struk Tol':'toll','Foto Biaya Lain-lain':'other'};Object.keys(p).forEach(x=>{const c=h[normalize_(x)];if(c!==undefined&&u[p[x]])s.getRange(r,c+1,n,1).setFormula('=HYPERLINK("'+u[p[x]]+'","View Photo")');});}
function enqueue_(ss,o){let q=ss.getSheetByName(CFG.QUEUE_SHEET);if(!q){q=ss.insertSheet(CFG.QUEUE_SHEET);q.appendRow(['Created','Status','JSON']);q.hideSheet();}q.appendRow([new Date(),'PENDING',JSON.stringify(o)]);}function ensureQueueTrigger_(){if(!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='processCallsheetQueue'))ScriptApp.newTrigger('processCallsheetQueue').timeBased().everyMinutes(1).create();}
function processCallsheetQueue(){const ss=SpreadsheetApp.openById(CFG.SPREADSHEET_ID),q=ss.getSheetByName(CFG.QUEUE_SHEET);if(!q||q.getLastRow()<2)return;const rows=q.getRange(2,1,q.getLastRow()-1,3).getValues();for(let i=0;i<rows.length;i++){if(rows[i][1]!=='PENDING')continue;const r=i+2;try{q.getRange(r,2).setValue('PROCESSING');const job=JSON.parse(rows[i][2]),url=createCallsheetPdf_(job);writePdfLink_(ss,job,url);q.getRange(r,2).setValue('DONE');}catch(e){q.getRange(r,2).setValue('ERROR: '+e.message);}break;}}
function createCallsheetPdf_(job){job.photoData={};Object.keys(job.photoUrls||{}).forEach(k=>{const m=String(job.photoUrls[k]).match(/[-\w]{25,}/);if(m){const b=DriveApp.getFileById(m[0]).getBlob();job.photoData[k]='data:'+b.getContentType()+';base64,'+Utilities.base64Encode(b.getBytes());}});const t=HtmlService.createTemplateFromFile('CallsheetPDF');t.job=job;t.approver=approver_(job.area);const blob=Utilities.newBlob(t.evaluate().getContent(),'text/html','Daily Callsheet.html').getAs(MimeType.PDF).setName('Daily Callsheet_'+safe_(job.payload.header.jobOrder)+'.pdf');return DriveApp.getFolderById(job.folderId).createFile(blob).getUrl();}
function writePdfLink_(ss,j,u){const s=ss.getSheetByName(j.area),h=headerMap_(s.getRange(1,1,1,s.getLastColumn()).getDisplayValues()[0]),c=h[normalize_('Callsheet PDF')];if(c!==undefined)s.getRange(j.rowStart,c+1,j.count,1).setFormula('=HYPERLINK("'+u+'","View PDF")');}
function getJobStatus(id){const q=SpreadsheetApp.openById(CFG.SPREADSHEET_ID).getSheetByName(CFG.QUEUE_SHEET);if(!q)return{status:'NOT_FOUND'};const v=q.getDataRange().getValues();for(let i=1;i<v.length;i++){let o;try{o=JSON.parse(v[i][2]||'{}');}catch(e){continue;}if(o.jobId===id){const s=String(v[i][1]);return{status:s,pdfUrl:s==='DONE'?findPdfUrl_(o):''};}}return{status:'NOT_FOUND'};}
function findPdfUrl_(j){const s=SpreadsheetApp.openById(CFG.SPREADSHEET_ID).getSheetByName(j.area),h=headerMap_(s.getRange(1,1,1,s.getLastColumn()).getDisplayValues()[0]),c=h[normalize_('Callsheet PDF')];if(c===undefined)return'';const m=s.getRange(j.rowStart,c+1).getFormula().match(/HYPERLINK\("([^"]+)/i);return m?m[1]:'';}
function approver_(a){a=normalize_(a);if(a.includes('cikarang'))return['Vickry Fauzi','Dispatcher'];if(a.includes('bogor')||a.includes('ciampea')||a.includes('dramaga'))return['Doni Firmansyah','Dispatcher'];if(a.includes('tangerang')||a.includes('pondok pinang'))return['Kiki Indra','Dispatcher'];if(a.includes('jakarta utara')||a.includes('jakarta pusat')||a.includes('sunter')||a.includes('kemayoran'))return['Moh Rizal Efendi','Dispatcher'];if(a.includes('serang'))return['Toni Haryanto','Dispatcher'];return['Hendri Piwara','Dispatcher'];}
function headerMap_(h){const o={};h.forEach((v,i)=>o[normalize_(v)]=i);return o;}function findHeader_(m,n){for(let i=0;i<n.length;i++){const x=normalize_(n[i]);if(m[x]!==undefined)return m[x];}return-1;}function normalize_(s){return String(s||'').trim().toLowerCase().replace(/\s+/g,' ');}function normalizePlate_(s){return String(s||'').toUpperCase().replace(/[^A-Z0-9]/g,'');}function proper_(s){return String(s||'').toLowerCase().replace(/\b\w/g,c=>c.toUpperCase()).trim();}function safe_(s){return String(s||'Tanpa Nama').replace(/[\\/:*?"<>|]/g,'-').trim();}function canonicalArea_(s){const n=normalize_(s),x=ROUTES.concat(AREAS).find(a=>normalize_(a)===n);return x||String(s).trim();}
