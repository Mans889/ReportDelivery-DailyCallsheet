function approver_(a){a=normalize_(a);if(a.indexOf('cikarang')>=0)return['Vickry Fauzi','Dispatcher'];if(a.indexOf('bogor')>=0)return['Doni Firmansyah','Dispatcher'];if(a.indexOf('tangerang')>=0||a.indexOf('pondok pinang')>=0)return['Kiki Indra','Dispatcher'];if(a.indexOf('jakarta utara')>=0||a.indexOf('jakarta pusat')>=0)return['Moh Rizal Efendi','Dispatcher'];if(a.indexOf('serang')>=0)return['Toni Haryanto','Dispatcher'];return['Hendri Piwara','Dispatcher'];}
function headerMap_(h){var o={};h.forEach(function(v,i){o[normalize_(v)]=i;});return o;}function findHeader_(m,n){for(var i=0;i<n.length;i++){var x=normalize_(n[i]);if(m[x]!==undefined)return m[x];}return-1;}function normalize_(s){return String(s||'').trim().toLowerCase().replace(/\s+/g,' ');}function normalizePlate_(s){return String(s||'').toUpperCase().replace(/[^A-Z0-9]/g,'');}function proper_(s){return String(s||'').toLowerCase().replace(/(^|[\s'-])([a-z])/g,function(m,p,c){return p+c.toUpperCase();}).trim();}function safe_(s){return String(s||'Tanpa Nama').replace(/[\\/:*?"<>|]/g,'-').trim();}
