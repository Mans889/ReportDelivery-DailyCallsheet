function submitData(p){validate_(p);var lock=LockService.getScriptLock();lock.waitLock(30000);try{var ss=SpreadsheetApp.openById(CFG.SPREADSHEET_ID),area=appArea_(p.header.area),sheet=ensureAreaSheet_(ss,area),week='Week '+Utilities.formatDate(new Date(p.header.date+'T00:00:00'),CFG.TZ,'w'),folders=buildFolders_(area,week,p.header.date,p.header.vendor,p.header.driver),start=Math.max(2,sheet.getLastRow()+1),hm=headerMap_(sheet.getRange(1,1,1,sheet.getLastColumn()).getDisplayValues()[0]),storePhotoUrls=[],rows=[];p.stores.forEach(function(s,idx){var urls={};Object.keys(s.photos||{}).forEach(function(k){if(s.photos[k])urls[k]=saveDataUrl_(folders[k]||folders.root,s.photos[k],k+'_Toko'+(idx+1));});storePhotoUrls.push(urls);var rec=recordFor_(p,s,week,urls),row=new Array(sheet.getLastColumn()).fill('');OUTPUT_HEADERS.forEach(function(h){var c=hm[normalize_(h)];if(c!==undefined)row[c]=rec[h]!==undefined?rec[h]:'';});rows.push(row);});sheet.getRange(start,1,rows.length,rows[0].length).setValues(rows).setHorizontalAlignment('center').setVerticalAlignment('middle').setBorder(true,true,true,true,true,true,'#9ca3af',SpreadsheetApp.BorderStyle.DASHED);sheet.setHiddenGridlines(true);applyLinks_(sheet,start,hm,storePhotoUrls);var jobId=Utilities.getUuid();enqueue_(ss,{jobId:jobId,area:area,rowStart:start,count:rows.length,payload:p,storePhotoUrls:storePhotoUrls,folderId:folders.pdf.getId()});ensureQueueTrigger_();return{ok:true,jobId:jobId,message:'Data tersimpan. PDF diproses di latar belakang.'};}finally{lock.releaseLock();}}
function validate_(p){if(!p||!p.header)throw new Error('Payload tidak valid.');['date','jobOrder','area','crewId','driver','plate','timeIn','timeOut'].forEach(function(k){if(!String(p.header[k]||'').trim())throw new Error('Field wajib belum lengkap: '+k);});if(!/^JO-\d+$/.test(p.header.jobOrder))throw new Error('No. Job Order harus JO- diikuti angka.');if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(p.header.timeIn)||!/^([01]\d|2[0-3]):[0-5]\d$/.test(p.header.timeOut))throw new Error('Format waktu wajib HH:MM 24 jam.');var boot=getBootstrapData(),a=appArea_(p.header.area);if(!boot.crews.some(function(x){return x.appArea===a&&normalizePlate_(x.plate)===normalizePlate_(p.header.plate);}))throw new Error('Nomor Polisi tidak tersedia pada Area yang dipilih.');p.stores.forEach(function(s,i){if(!s.id||!s.name)throw new Error('Data toko ke-'+(i+1)+' belum lengkap.');var req={tkbm:'Foto Kwitansi TKBM',parking:'Foto Parkir Liar',giro:'Foto Giro',security:'Foto Keamanan',toll:'Foto Tol',other:'Foto Lain-lain'};Object.keys(req).forEach(function(k){if(Number((s.costs||{})[k]||0)>0&&!(s.photos||{})[k])throw new Error(req[k]+' toko ke-'+(i+1)+' wajib.');});});}
