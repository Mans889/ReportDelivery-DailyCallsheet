function getOrCreate_(p,n){var i=p.getFoldersByName(n);return i.hasNext()?i.next():p.createFolder(n);}function saveDataUrl_(f,d,l){var m=String(d).match(/^data:(image\/[\w.+-]+);base64,(.+)$/);if(!m)throw new Error('Format foto tidak valid.');return f.createFile(Utilities.newBlob(Utilities.base64Decode(m[2]),m[1],safe_(l)+'_'+Date.now()+'.jpg')).getUrl();}
