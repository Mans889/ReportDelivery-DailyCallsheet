function getBootstrapData(){var ss=SpreadsheetApp.openById(CFG.SPREADSHEET_ID),md=ss.getSheetByName(CFG.MASTER_DATA_SHEET);if(!md)throw new Error('Sheet MASTER-DATA tidak ditemukan.');var lc=md.getLastColumn(),hm=headerMap_(md.getRange(17,1,1,lc).getDisplayValues()[0]),ix={area:findHeader_(hm,['area']),crew:findHeader_(hm,['crew id']),driver:findHeader_(hm,['nama driver']),helper:findHeader_(hm,['nama helper']),plate:findHeader_(hm,['nomor polisi']),unit:findHeader_(hm,['tipe unit']),vendor:findHeader_(hm,['vendor'])};validateHeaders_(ix);var n=Math.max(0,md.getLastRow()-17),rows=n?md.getRange(18,1,n,lc).getDisplayValues():[],days=[8,9,10,11,12,13,14],crews=rows.filter(function(r){return r[ix.crew]||r[ix.driver];}).map(function(r){return{area:r[ix.area]||'',appArea:appArea_(r[ix.area]),crewId:r[ix.crew]||'',driver:r[ix.driver]||'',helper:r[ix.helper]||'',plate:normalizePlate_(r[ix.plate]),unit:r[ix.unit]||'',vendor:r[ix.vendor]||'',schedule:days.map(function(i){return r[i]||'';})};});var st=ss.getSheetByName(CFG.MASTER_STORE_SHEET);if(!st)throw new Error('Sheet MASTER-TOKO 5.2 tidak ditemukan.');var sn=Math.max(0,st.getLastRow()-12),stores=sn?st.getRange(13,2,sn,3).getDisplayValues().filter(function(r){return r[0]&&r[1];}).map(function(r){return{area:String(r[0]).trim(),appArea:appArea_(r[0]),id:String(r[1]).trim(),name:String(r[2]).trim()};}):[];return{ok:true,areas:AREAS,routes:ROUTES,crews:crews,stores:stores};}
