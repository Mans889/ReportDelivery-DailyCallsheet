const CALLSHEET_API_TOKEN=PropertiesService.getScriptProperties().getProperty('CALLSHEET_API_TOKEN');function doGet(){return jr_({ok:true,status:'READY'});}function doPost(e){try{var b=JSON.parse(e.postData.contents||'{}');if(b.token!==CALLSHEET_API_TOKEN)return jr_({ok:false,message:'Unauthorized'});if(b.action==='bootstrap')return jr_(getBootstrapData());if(b.action==='submit')return jr_(submitData(b.payload));if(b.action==='status')return jr_(getJobStatus(b.payload.jobId));return jr_({ok:true,status:'READY'});}catch(x){return jr_({ok:false,message:String(x.message||x)});}}function jr_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
